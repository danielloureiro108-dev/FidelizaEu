# ---- Supabase (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...            # chave "anon public"
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...               # chave "service_role" (SEGREDO)

# ---- Conexão direta ao Postgres (para aplicar migrations) ----
# Settings > Database > Connection string > "Direct connection" (ou "Session pooler").
# Substitua [YOUR-PASSWORD] pela senha do banco. NÃO use a "Transaction pooler" aqui.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxx.supabase.co:5432/postgres

# ---- Multi-tenant ----
# Domínio-raiz da plataforma. Os estabelecimentos ganham subdomínios:
#   donario.SEU-ROOT, barx.SEU-ROOT, ...
# Cada um também pode ter domínio próprio (campo custom_domain do tenant).
ROOT_DOMAIN=fidelidade.suaempresa.com.br

# Fallback para deploy de UM único estabelecimento (opcional).
# Se ROOT_DOMAIN resolver o tenant pelo host, isto é ignorado.
# TENANT_SLUG=seu-donario
